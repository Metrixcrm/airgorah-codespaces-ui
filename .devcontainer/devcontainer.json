{
  "name": "Airgorah Codespaces UI",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": {
      "noVncVersion": "1.2.0",
      "webPort": "6080",
      "vncPort": "5901",
      "password": "noPassword"
    }
  },
  "containerEnv": {
    "VNC_RESOLUTION": "1024x600x16"
  },
  "forwardPorts": [5901, 6080],
  "portsAttributes": {
    "6080": {
      "label": "Airgorah browser desktop",
      "protocol": "http",
      "onAutoForward": "openPreview"
    },
    "5901": {
      "label": "Airgorah VNC",
      "protocol": "tcp",
      "onAutoForward": "ignore"
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "sudo /usr/local/share/desktop-init.sh && bash /workspaces/airgorah-codespaces-ui/start-ui.sh",
  "remoteUser": "vscode"
}
